datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

model bosses {
  id            Int     @id @default(autoincrement())
  name          String
  max_hp        Int
  current_hp    Int
  type_weakness String // Removido enum para simplificar no SQLite
}

model habits {
  id             Int      @id @default(autoincrement())
  user_id        Int
  title          String
  description    String?
  type           String
  difficulty     String
  frequency_type String
  created_at     DateTime @default(now())
}

model users {
  id             Int     @id @default(autoincrement())
  username       String  @unique
  password       String
  level          Int     @default(1)
  total_xp       Int     @default(0)
  current_streak Int     @default(0)
  active_boss_id Int?
}